{
  "buildCommand": "node seo/build.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/classic",
      "destination": "/Home.dc.html"
    },
    {
      "source": "/services",
      "destination": "/Service.dc.html"
    },
    {
      "source": "/contact",
      "destination": "/Contact.dc.html"
    }
  ],
  "redirects": [
    {
      "source": "/Work.dc.html",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/Home.dc.html",
      "destination": "/",
      "permanent": true
    }
  ]
}